{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "buildCommand": "npm run build"
    },
    "admin-panel": {
      "root": "frontend/admin-panel",
      "framework": "nextjs"
    },
    "chrome-extension": {
      "root": "frontend/chrome-extension",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "web-dashboard": {
      "root": "frontend/web-dashboard",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-dashboard"
      }
    }
  ]
}
